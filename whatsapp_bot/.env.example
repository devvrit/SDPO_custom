# Copy this to .env and fill in your values

# Twilio credentials — https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio WhatsApp sandbox number (the "from" number)
# Format: whatsapp:+14155238886
TWILIO_WA_NUMBER=whatsapp:+14155238886

# YOUR WhatsApp number(s) — comma separated, no spaces
# Format: whatsapp:+<country_code><number>
ALLOWED_NUMBERS=whatsapp:+919876543210

# Optional
PORT=8000
RESPONSE_TIMEOUT=600
PROGRESS_INTERVAL=30
QUEUE_DIR=/fsx/ubuntu/repos/SDPO_custom/whatsapp_bot/queue
